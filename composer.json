{
    "name": "trick77/trakk-wordpress",
    "description": "Development tools; the plugin itself has no dependencies.",
    "license": "MIT",
    "type": "project",
    "require": {
        "php": ">=8.1"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.95",
        "phpstan/phpstan": "^2.3",
        "phpunit/phpunit": "^10.5"
    },
    "scripts": {
        "fix": "php-cs-fixer fix",
        "lint": "php-cs-fixer check --diff",
        "stan": "phpstan analyse",
        "test": "phpunit"
    },
    "config": {
        "platform": {
            "php": "8.1.0"
        },
        "sort-packages": true
    }
}
